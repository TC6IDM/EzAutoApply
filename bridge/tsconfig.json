{
  // Type-checked with the extension's TypeScript (no packages of its own): npm run compile.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "typeRoots": ["../extension/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src", "test"]
}
